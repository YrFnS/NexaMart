# PostgreSQL is required by prisma/schema.prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexamart?schema=public"

# Generate with: openssl rand -base64 48
# Keep this server-only and use at least 32 characters in production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Application origins used for secure cookies and same-origin request checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional server-to-server admin bearer token. Never expose this with a
# NEXT_PUBLIC_ prefix and never place it in browser storage.
ADMIN_SECRET_KEY=""

# Demo login is disabled in production unless explicitly enabled.
ENABLE_DEMO_LOGIN="false"

# Optional AI integration.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# Optional public application settings.
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_APP_ADDRESS="Baghdad, Iraq"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Baghdad"

# Required only when running `npm run db:seed`.
SEED_DEMO_PASSWORD=""
