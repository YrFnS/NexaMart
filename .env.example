# PostgreSQL is required by prisma/schema.prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexamart?schema=public"

# Deployment identity used by /api/health and non-production indexing controls.
# Use development locally, staging for shared pre-release environments, and
# production only for the public release deployment.
DEPLOYMENT_ENV="development"
# Optional when the hosting provider exposes a supported commit variable.
RELEASE_SHA=""

# Generate with: openssl rand -base64 48
# Keep this server-only and use at least 32 characters in production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Application origins used for secure cookies and same-origin request checks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Required in production for shared API rate limiting across serverless or
# horizontally scaled instances. Copy the REST credentials from Upstash Redis.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Maximum time spent waiting for the Redis REST API before failing closed.
RATE_LIMIT_REDIS_TIMEOUT_MS="2000"
# Development and isolated previews may opt into a per-instance fallback.
# Keep this false in production and production-like staging.
RATE_LIMIT_ALLOW_MEMORY_FALLBACK="false"

# Optional server-to-server admin bearer token. Never expose this with a
# NEXT_PUBLIC_ prefix and never place it in browser storage.
ADMIN_SECRET_KEY=""
# Required only when ADMIN_SECRET_KEY automation performs audited writes.
ADMIN_AUTOMATION_USER_ID=""

# Orders waiting for seller confirmation are eligible for automated cancellation
# after this many hours. Keep between 1 and 168.
ORDER_CONFIRMATION_TTL_HOURS="24"

# Demo login is disabled in production unless explicitly enabled.
ENABLE_DEMO_LOGIN="false"

# Optional AI integration.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"

# Optional public application settings.
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
NEXT_PUBLIC_SUPPORT_PHONE=""
NEXT_PUBLIC_APP_ADDRESS="Baghdad, Iraq"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Baghdad"

# Required only when running `npm run db:seed`.
SEED_DEMO_PASSWORD=""
