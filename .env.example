# PostgreSQL only. Use a dedicated application user in production.
DATABASE_URL="postgresql://nexamart:change-me@localhost:5432/nexamart?schema=public"

# Generate with: openssl rand -hex 32
# Required. The application fails closed when this is missing or shorter than 32 characters.
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Canonical application origins used for redirects and same-origin request checks.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"

# Demo access must be explicitly enabled in production.
ALLOW_DEMO_LOGIN="false"

# Temporary migration escape hatch only. Keep disabled for normal operation.
ALLOW_LEGACY_ADMIN_KEY="false"
# ADMIN_SECRET_KEY="set-only-while-migrating-legacy-admin-clients"

# Optional AI features.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemini-2.0-flash-001"
